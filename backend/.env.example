PORT=8080
# PostgreSQL compartido de Supabase (Connect > Session pooler en puerto 5432 o Transaction pooler en 6543).
# En producción/Vercel es obligatoria (fail-fast si no se define).
DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
# Pool máximo de conexiones por proceso/instancia (default: 1 en producción, 10 en desarrollo local)
DB_POOL_MAX=1
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
# Opcional: lista separada por comas de orígenes permitidos (ej. https://frontend.vercel.app,http://localhost:3000)
CORS_ORIGINS=
# Opcional: permitir preview deployments de Vercel acotados al proyecto (deshabilitado por defecto)
ALLOW_VERCEL_PREVIEWS=false
# Nombre del proyecto en Vercel para acotar previews permitidos
VERCEL_PREVIEW_PROJECT_NAME=sistema-reconstruccion-motores

