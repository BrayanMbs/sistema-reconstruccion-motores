PORT=8080
# PostgreSQL compartido de Supabase (Connect > Session pooler en puerto 5432 o Transaction pooler en 6543).
# En producción/Vercel es obligatoria (fail-fast si no se define).
DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
# Opcional: lista separada por comas de orígenes permitidos (ej. https://frontend.vercel.app,http://localhost:3000)
CORS_ORIGINS=
# Opcional: permitir preview deployments de Vercel (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

