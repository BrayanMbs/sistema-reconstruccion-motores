BACKEND_PORT=8080
FRONTEND_PORT=3000

# PostgreSQL compartido de Supabase Cloud (Connect > Session pooler en puerto 5432 o Transaction pooler en 6543).
# Codifique los caracteres especiales de la contraseña (por ejemplo, # como %23).
DATABASE_URL=
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=5
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# Supabase Auth & Storage API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL del Frontend (para CORS en Backend)
FRONTEND_URL=http://localhost:3000
# Opcional: lista separada por comas de orígenes CORS permitidos
CORS_ORIGINS=
# Opcional: permitir preview deployments de Vercel (*.vercel.app)
ALLOW_VERCEL_PREVIEWS=false

# Frontend API URL
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

